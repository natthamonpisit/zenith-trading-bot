# Supabase Configuration
SUPABASE_URL="your_supabase_url_here"
SUPABASE_KEY="your_supabase_key_here"
# Optional direct Postgres connection (for psql/migrations)
DATABASE_URL="postgresql://postgres:<db-secret>@db.your-project-ref.supabase.co:5432/postgres"

# AI Configuration
GEMINI_API_KEY="your_gemini_api_key_here"
MINIMAX_API_KEY="your_minimax_api_key_here"
MINIMAX_CODING_PLAN_KEY="your_minimax_coding_plan_key_here"
MINIMAX_CODING_MODEL="MiniMax-M2.5"
MINIMAX_API_BASE_URL="https://api.minimax.io/v1"
MINIMAX_TIMEOUT_SEC="20"
MINIMAX_COMPLEXITY_THRESHOLD="10"
STRATEGIST_PRIMARY_PROVIDER="MINIMAX_CODING"

# Exchange Configuration (Binance Thailand)
BINANCE_API_KEY="your_binance_api_key_here"
BINANCE_SECRET="your_binance_secret_here"
BINANCE_API_URL="https://api.binance.th"
# Radar global scan source (for broader/faster candidate discovery)
RADAR_SCAN_EXCHANGE_ID="bybit"
RADAR_SCAN_QUOTE="USDT"
RADAR_SCAN_FORCE_GLOBAL="true"

# Optional Multi-Asset Connectors (set to mark LIVE tradable for non-crypto)
STOCK_API_NAME=""
STOCK_API_URL=""
STOCK_API_KEY=""
GOLD_API_NAME=""
GOLD_API_URL=""
GOLD_API_KEY=""
SILVER_API_NAME=""
SILVER_API_URL=""
SILVER_API_KEY=""

# Scanner symbol presets for non-crypto radar (Yahoo quote fallback)
STOCK_SCAN_SYMBOLS="AAPL,MSFT,NVDA,SPY,TSLA,AMZN"
GOLD_SCAN_SYMBOLS="XAUUSD=X,GC=F"
SILVER_SCAN_SYMBOLS="XAGUSD=X,SI=F"
YAHOO_QUOTE_TIMEOUT_SEC="8"

# Bot Settings
ENV="development"
# Optional dashboard auth fallback (if not using .streamlit/secrets.toml)
ADMIN_ACCESS_SECRET="change_me"

# API Service Settings
API_HOST="0.0.0.0"
API_PORT="8000"
API_RELOAD="false"
API_RATE_LIMIT_PER_MIN="180"
API_CORS_ORIGINS="*"
# Optional: require X-API-Key on read endpoints when set
API_READ_TOKEN=""

# Frontend (React dashboard)
VITE_API_BASE_URL="http://localhost:8000"
# Keep same as API_READ_TOKEN when API token auth is enabled
VITE_API_KEY=""
